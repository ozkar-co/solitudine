# Mapeo mando R36S → teclado (depuración fase 0)
# Ver https://portmaster.games/gptokeyb-documentation.html

back = escape
start = return

a = space
b = z
x = x
y = c

l1 = q
l2 = w
r1 = e
r2 = r
l3 = t
r3 = y

up = up
down = down
left = left
right = right

left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

right_analog_up = i
right_analog_down = k
right_analog_left = j
right_analog_right = l
